{
  "agk-session-context": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/hooks.mjs SessionStart",
        "timeout": 10
      }
    ]
  },
  "agk-safety-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks.mjs PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "agk-verify-gate": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/hooks.mjs PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/hooks.mjs Stop",
        "timeout": 5
      }
    ]
  }
}
